{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react",
    "jsxFactory": "ReactEcs.createElement",
    "lib": ["ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["@dcl/js-runtime"]
  },
  "include": ["src/**/*"]
}
